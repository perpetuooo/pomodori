{
  "manifest_version": 3,
  "name": "Pomodori",
  "version": "0.1.0",
  "description": "Simply a Pomodoro timer.",
  "homepage_url": "https://github.com/perpetuooo/pomodori",

  "icons": {
    "48": "icons/tomato.svg",
    "96": "icons/tomato.svg"
  },

  "permissions": ["activeTab", "scripting", "storage", "alarms", "notifications"],
  "browser_specific_settings": {
    "gecko": {
      "id": "tomato@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "action": {
    "default_icon": "icons/tomato-32.png",
    "theme_icons": [
        {
            "light": "icons/tomato-32-light.png",
            "dark": "icons/tomato-32.png",
            "size": 32
        }
    ],
    "default_title": "Pomodori",
    "default_popup": "index.html"
  },

  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["*://*/*", "<all_urls>"]
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
